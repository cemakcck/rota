# Copy to .env.local. Defaults work with `npm run db:up` (docker compose Postgres on :5434).
DATABASE_URL=postgres://rota:rota@localhost:5434/rota
TEST_DATABASE_URL=postgres://rota:rota@localhost:5434/rota_test
# The one port for pages, API and the /sync socket. Railway sets it in production.
PORT=3400
# Signs sessions. Generate a fresh one for production: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-only-secret-replace-in-production
# The public origin: auth callbacks and the links in invite and reset emails.
BETTER_AUTH_URL=http://localhost:3400
# Keys the hash of visitor IPs used for rate limiting (raw IPs are never stored). Required in production.
IP_HASH_SECRET=local-dev-only-ip-secret
# Proxies in front of the app that append to X-Forwarded-For; the client IP is that many entries from
# the end. 1 suits Railway's edge; 0 ignores the header.
TRUSTED_PROXY_HOPS=1
# Needed in production: without a key, emails (invites AND password-reset links) are only written to
# the server log, so nobody receives them. Fine for local development.
RESEND_API_KEY=
EMAIL_FROM=Tripify <onboarding@resend.dev>
# How long the demo's scripted friend waits before joining a new demo trip.
FRIEND_DELAY_MS=10000
# Set to off to skip the demo's 20-starts-per-day limit on your machine. Ignored in production.
DEMO_RATE_LIMIT=
