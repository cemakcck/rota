# Copy to .env.local. Defaults work with `npm run db:up` (docker compose Postgres on :5434).
DATABASE_URL=postgres://rota:rota@localhost:5434/rota
TEST_DATABASE_URL=postgres://rota:rota@localhost:5434/rota_test
PORT=3400
# Signs sessions. Generate a fresh one for production: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-only-secret-replace-in-production
BETTER_AUTH_URL=http://localhost:3400
IP_HASH_SECRET=local-dev-only-ip-secret
# Optional: without a key, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=Rota <onboarding@resend.dev>
